    <!-- صندوق الإعداد الآمن للـ API -->
    <div class="setup-box">
        <div class="input-group">
            <label for="apiKey">مفتاح OpenAI API الخاص بك (يتم تشفيره محلياً في متصفحك ولا يرسل لأي سيرفر وسيط):</label>
            <input type="password" id="apiKey" placeholder="sk-proj-..." autocomplete="off">
        </div>
    </div>

    <!-- صندوق السؤال الأساسي -->
    <div class="main-textarea">
        <label for="question">السؤال التحليلي الخاضع للفحص والدراسة السلوكية:</label>
        <textarea id="question" rows="4" placeholder="اكتب سؤالك الفلسفي أو العلمي المعقد هنا لتلاحظ الفارق الجوهري بين مستويات الوعي..."></textarea>
    </div>

    <div style="text-align: center;">
        <button id="sendBtn" onclick="executeLiveSimulation()">بدء المحاكاة الحية والربط الفوري</button>
    </div>

    <!-- لوحة التحكم الحيوية والرسوم البيانية -->
    <div class="dashboard" id="dashboard">
