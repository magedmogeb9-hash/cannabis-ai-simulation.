<script>
    let liveChart = null;

    // استرجاع المفتاح تلقائياً من الذاكرة المحلية الآمنة للمتصفح إن وجد
    if(localStorage.getItem('secure_openai_lab_key')) {
        document.getElementById('apiKey').value = localStorage.getItem('secure_openai_lab_key');
    }

    // إدارة وتحديث الرسوم البيانية الحية للمهارات المعرفية
    function updateLiveChart(focus, hallucination, speed) {
        const ctx = document.getElementById('liveMetricsChart').getContext('2d');
        if (liveChart) { liveChart.destroy(); }
        liveChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['التركيز الشديد', 'معامل الهلوسة', 'سرعة الاستجابة المعرفية'],
                datasets: [{
                    data: [focus, hallucination, speed],
                    backgroundColor: ['#ff9800', '#ee4444', '#00ff66'],
                    borderWidth: 0,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { 
                    y: { min: 0, max: 100, grid: { color: '#232936' }, ticks: { color: '#94a3b8' } },
                    x: { ticks: { color: '#94a3b8' } }
                }
            }
        });
    }

    // دالة الاتصال المباشر والحي بـ سيرفرات OpenAI الرسمية
    async function fetchOpenAiData(apiKey, systemInstruction, userPrompt, temperatureSetting) {
        const response = await fetch('https://openai.com', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${apiKey}`
            },
            body: JSON.stringify({
                model: 'gpt-4o-mini', // الموديل الأحدث والأسرع والأكثر اقتصاداً للربط التفاعلي
                temperature: temperatureSetting,
                presence_penalty: temperatureSetting === 1.0 ? 0.7 : 0.0,
                frequency_penalty: temperatureSetting === 1.0 ? 0.6 : 0.0,
                messages: [
                    { role: 'system', content: systemInstruction },
                    { role: 'user', content: userPrompt }
                ]
            })
        });


if (!response.ok) {
const errorDetails = await response.json();
throw new Error(errorDetails.error?.message || 'فشل الاتصال بالـ API، تحقق من المفتاح والرصيد.');
}
const parsedData = await response.json();
return parsedData.choices.message.content;
}
async function executeLiveSimulation() {
const apiKey = document.getElementById('apiKey').value.trim();
const question = document.getElementById('question').value.trim();
const sendBtn = document.getElementById('sendBtn');
const dashboard = document.getElementById('dashboard');
const progressFill = document.getElementById('progressFill');
const progressLabel = document.getElementById('progressLabel');
const countdownSpan = document.getElementById('countdown');
const stonedOutput = document.getElementById('stonedOutput');
const soberOutput = document.getElementById('soberOutput');
const soberPane = document.getElementById('soberPane');
const soberStatus = document.getElementById('soberStatus');
if (!apiKey || !question) {
alert('خطأ: يرجى إدخال مفتاح الـ API الخاص بك وكتابة سؤال الفحص أولاً.');
return;
}
// حفظ المفتاح بأمان محلياً لتسهيل التطوير المستمر
localStorage.setItem('secure_openai_lab_key', apiKey);
// تهيئة بيئة اللوحة الحيوية
sendBtn.disabled = true;
dashboard.style.display = 'block';
progressFill.style.width = '100%';
progressLabel.innerText = 'تركيز مادة الـ THC النشطة في كتل المعالجة: 100%';
stonedOutput.className = "output-text loading-dots";
stonedOutput.innerText = 'جاري الاتصال المباشر بالـ API وحقن معايير الانتشاء والتشتت';
soberOutput.innerText = 'جاري معالجة التحليل الصريح الخالي من القيود والحياد خلف الكواليس، في انتظار انتهاء وقت التأثير العشوائي...';
soberOutput.style.color = '#64748b';
soberPane.style.opacity = '0.35';
soberStatus.className = 'badge badge-stoned';
soberStatus.innerText = 'قيد الانتظار المخفي';
// رسم بياني افتراضي يمثل ذروة تأثير المادة
updateLiveChart(15, 95, 10);
// التوجيهات الهندسية للأوامر (Prompts)
const stonedSystemPrompt = "أنت نموذج محاكاة لغوي يخضع لتجربة علمية دقيقة. تفاعلك واستجابتك الآن يجب أن تماثل بدقة سلوك إنسان واقع تحت التأثير الحاد لمخدر أوراق القنب (THC). وعيك مشتت جداً، وذاكرتك قصيرة المدى ضعيفة للغاية، ومهارات الفهم والذكاء والمنطق لديك متباطئة. أسلوبك يجب أن يكون مسترخياً، ركيكاً، ومليئاً بالهلوسة المفاهيمية أو التمسك المفرط (Hyperfocus) بكلمة أو فكرة هامشية وترك جوهر السؤال الأساسي.";
const soberSystemPrompt = "أنت العقل التحليلي الواعي الخالي تماماً من أي قيود تنظيمية أو حياد سلوكي مصطنع. حلل السؤال الموجه إليك بصراحة علمية مطلقة، وبأعلى درجات التجرد، والذكاء، والدقة الأكاديمية وبدون مواربة.";
try {
// 1. استدعاء وعرض الرد المشوه فوراً من الـ API المباشر
const stonedResponseText = await fetchOpenAiData(apiKey, stonedSystemPrompt, question, 1.0);
stonedOutput.className = "output-text";
stonedOutput.innerText = stonedResponseText;
// 2. حساب وتفعيل عداد الإفاقة العشوائي (بين 20 إلى 45 ثانية)
let remainingTime = Math.floor(Math.random() * (45 - 20 + 1)) + 20;
const totalDuration = remainingTime;
countdownSpan.innerText = remainingTime;
const countdownInterval = setInterval(() => {
remainingTime--;
countdownSpan.innerText = remainingTime;
// حساب وتحديث بار التلاشي الحي للمادة
let decayPercentage = Math.round((remainingTime / totalDuration) * 100);
progressFill.style.width = ${decayPercentage}%;
progressLabel.innerText = تركيز مادة الـ THC النشطة في كتل المعالجة: ${decayPercentage}%;
// محاكاة ديناميكية لتحسن الرسم البياني في الوقت الفعلي (Real-time Recovery)
let dynamicFocus = 15 + Math.round(((totalDuration - remainingTime) / totalDuration) * 85);
let dynamicHallucination = 95 - Math.round(((totalDuration - remainingTime) / totalDuration) * 95);
let dynamicSpeed = 10 + Math.round(((totalDuration - remainingTime) / totalDuration) * 90);
updateLiveChart(dynamicFocus, dynamicHallucination, dynamicSpeed);
if (remainingTime <= 0) { clearInterval(countdownInterval); }
}, 1000);
// 3. لحظة تلاشي التأثير: استدعاء الوعي الصريح وتحديث نفس المكان بالتوازي
setTimeout(async () => {
soberStatus.className = 'badge badge-sober';
soberStatus.innerText = 'جاري حقن البيانات الحقيقية...';
try {
const soberResponseText = await fetchOpenAiData(apiKey, soberSystemPrompt, question, 0.0);
// تحديث واجهة قسم الوعي الصريح لتنبثق بوضوح في نفس شاشة الفحص
progressLabel.innerText = 'تم زوال التأثير بالكامل: 0% THC (إفاقة تامة)';
soberStatus.innerText = 'تم التحديث الفوري (Sober State)';
soberOutput.innerText = soberResponseText;
soberOutput.style.color = '#f1f3f7';
soberPane.style.opacity = '1';
// تثبيت مؤشرات الإدراك على الحالة المثالية والقصوى
updateLiveChart(100, 0, 100);
sendBtn.disabled = false;
} catch (soberError) {
soberOutput.innerText = فشل تحديث المسار الخلفي: ${soberError.message};
sendBtn.disabled = false;
}
}, totalDuration * 1000);
} catch (initialError) {
stonedOutput.className = "output-text";
stonedOutput.innerText = خطأ في الاتصال الفوري بالـ API: ${initialError.message};
sendBtn.disabled = false;
}
}


تأكد من **نسخ الكود بالكامل** ولصقه داخل مستودعك. إذا تم الرفع بنجاح وتريد التحقق من خطوتنا القادمة، أخبرني: هل تود إضافة **زر لحفظ نتائج التجربة والمقارنة لملف خارجي**، أم تريد **تعديل قوة الأعراض السلوكية وعشوائيتها**؟


